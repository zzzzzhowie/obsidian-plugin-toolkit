		"tslib": "2.4.0",
		"typescript": "5.8.3",
		"eslint": "9.30.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
